[Desktop Entry]
Type=Application
Name=DocFAST
GenericName=Fast file converter & tools
Comment=Convert and edit files: start dragging a file and press Shift
Exec=docfast %F
Icon=docfast
Terminal=false
Categories=Utility;Graphics;Office;
Keywords=convert;compress;resize;pdf;heic;webp;image;docfast;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/avif;image/tiff;image/bmp;image/gif;image/x-icon;image/vnd.microsoft.icon;application/pdf;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;text/markdown;text/csv;
StartupNotify=false
